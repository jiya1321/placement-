# PlacePilot LLM Configuration
# Active provider: "gemini" (default, development) or "azure" (production submission)
LLM_PROVIDER=gemini

# Google Gemini API Credentials (free tier supported)
GEMINI_API_KEY=

# Azure OpenAI Credentials (used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
